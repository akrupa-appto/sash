{
  "manifest_version": 3,
  "name": "checkto — browser tasks",
  "version": "0.4.9",
  "description": "Run Checkto agents on your own tabs. Bring your API keys, stored only on this device.",
  "minimum_chrome_version": "118",
  "permissions": [
    "storage",
    "sidePanel",
    "debugger",
    "tabs",
    "tabGroups",
    "activeTab",
    "contextMenus",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://api.typesafe.ai/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "open checkto"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "Open the checkto panel"
    },
    "toggle-dictation": {
      "suggested_key": {
        "default": "Ctrl+Shift+Comma",
        "mac": "Command+Shift+Comma"
      },
      "description": "Voice dictation: press to talk, press again to stop, or press twice quickly to latch hands-free"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https: http://localhost:* http://127.0.0.1:*"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
